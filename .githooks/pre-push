#!/bin/sh
# Builds whatever the push changes (server/ and/or client/) and blocks the push
# if a build fails. Enable once per clone with:  git config core.hooksPath .githooks
# Skip in an emergency with:  git push --no-verify

ZERO=0000000000000000000000000000000000000000
changed=""

# Git passes one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch — nothing to build
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: compare against master (or build everything).
    base=$(git merge-base origin/master "$local_sha" 2>/dev/null)
    if [ -n "$base" ]; then
      files=$(git diff --name-only "$base" "$local_sha")
    else
      files="server/ client/"
    fi
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi
  changed="$changed
$files"
done

root=$(git rev-parse --show-toplevel)
build_server=$(echo "$changed" | grep -q '^server/' && echo yes)
build_client=$(echo "$changed" | grep -q '^client/' && echo yes)

if [ -z "$build_server" ] && [ -z "$build_client" ]; then
  echo "pre-push: no app code changed — skipping builds."
  exit 0
fi

fail() {
  echo ""
  echo "✖ pre-push: $1 build failed — push cancelled. Fix the errors above and push again."
  echo "  (To push anyway: git push --no-verify)"
  exit 1
}

if [ -n "$build_server" ]; then
  echo "▶ pre-push: type-checking and building the API (server/)…"
  (cd "$root/server" && npm run --silent typecheck && npm run --silent build) || fail "API"
  echo "✔ API build passed"
fi

if [ -n "$build_client" ]; then
  echo "▶ pre-push: building the website (client/)… this takes a minute or two"
  if command -v pnpm >/dev/null 2>&1; then
    (cd "$root/client" && pnpm run build) || fail "Website"
  else
    (cd "$root/client" && npx next build) || fail "Website"
  fi
  echo "✔ Website build passed"
fi

echo "✔ pre-push: all builds passed — pushing."
