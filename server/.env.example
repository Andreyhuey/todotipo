SITE_NAME=Oaken
SITE_LINK=https://oaken.andreyhuey.dev

# Database (as seen from the hosting server). Port 5432 => PostgreSQL, else MySQL;
# override with DB_TYPE=postgres|mysql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
# DB_TYPE=postgres
# DB_SYNC=true            # auto-create/alter tables (default true)

# SSH tunnel to the DB. Leave SSH_HOST empty when the API runs on the DB host.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
# SSH_PRIVATE_KEY=        # inline key alternative (\n-escaped)
# SSH_PASSPHRASE=
# SSH_HOST_FINGERPRINT=SHA256:...   # recommended: pins the server host key
DB_REMOTE_HOST=127.0.0.1
# DB_REMOTE_PORT=         # defaults to DB_PORT

# Media storage (FTP). Uploaded files are served from FTP_PUBLIC_URL.
# Folder on the FTP account that FTP_PUBLIC_URL serves, e.g. /oaken -> https://storage.example.com/oaken
FTP_BASE_PATH=/oaken
FTP_PUBLIC_URL=
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# FTP_SECURE=false
# MEDIA_MAX_UPLOAD_MB=100
# MEDIA_MAX_DIMENSION=2400

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Auth
JWT_SECRET=
# JWT_EXPIRES_IN=7d
NOTIFY_EMAIL=
CORS_ORIGINS=

# Used by `npm run create-admin` when no arguments are given
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Local development only: store uploads in ./uploads instead of FTP
# STORAGE_DRIVER=local
# PUBLIC_API_URL=http://localhost:8000

# Visitor analytics: ipgeolocation.io API key (IP -> location)
IP_GEO_LOCATION_CONFIG=
# IP_GEO_CACHE_DAYS=30   # reuse a lookup per IP for this many days

# Email warning/error activity-log entries as batched digests (unset = off)
# ALERT_EMAIL=logs@example.com
# ALERT_MIN_LEVEL=warning        # or "error"
# ALERT_ERROR_DELAY_SECONDS=60
# ALERT_WARNING_DELAY_MINUTES=5

# Scheduled reports (server/cron). Weekly summary + unread reminders go to
# REPORT_EMAIL, else the notification email from Site settings / NOTIFY_EMAIL.
# ANALYTICS_EMAIL=analytics@example.com   # daily visits email
# VISIT_EMAIL=analytics@example.com       # one email per visitor listing the pages they viewed; defaults to ANALYTICS_EMAIL, "off" disables
# VISIT_EMAIL_IDLE_MINUTES=15             # send once the visitor has been idle this long
# VISIT_EMAIL_MAX_MINUTES=20            # ...or at most this long after their first page
# REPORT_EMAIL=owner@example.com
# REPORT_TIMEZONE=Africa/Lagos            # what "yesterday" means
# VISIT_RETENTION_MONTHS=13
