# Public URL of this site (used for canonical links, sitemap, social cards)
NEXT_PUBLIC_BASE_URL=https://oaken.andreyhuey.dev
# Oaken API (server/) — used in production builds
NEXT_PUBLIC_API_URL=https://oaken-api.andreyhuey.dev
# API used by `next dev`
NEXT_PUBLIC_LOCAL_HOST_API_URL=http://localhost:8000

# Set to true to stop recording page views (e.g. on preview deployments)
# NEXT_PUBLIC_DISABLE_ANALYTICS=true
