# Public URL of this site (used for canonical links, sitemap, social cards)
NEXT_PUBLIC_BASE_URL=https://oaken.andreyhuey.dev
# Oaken's API runs inside the portfolio server (apps/server in the portfolio
# repo), mounted at /api/oaken — used in production builds
NEXT_PUBLIC_API_URL=https://api.andreyhuey.dev
# The portfolio server used by `next dev`
NEXT_PUBLIC_LOCAL_HOST_API_URL=http://localhost:5555
# Where Oaken's routes are mounted (default /api/oaken); /api for a standalone Oaken API
# NEXT_PUBLIC_API_PREFIX=/api/oaken

# Set to true to stop recording page views (e.g. on preview deployments)
# NEXT_PUBLIC_DISABLE_ANALYTICS=true
